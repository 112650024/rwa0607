# 複製成 .env 並填入(.env 不會進版控)
# Sepolia RPC(Alchemy / Infura 免費,或留空用公開節點)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/你的KEY
# 部署者 / 餵價者私鑰(burner 錢包,需有 Sepolia 測試 ETH 付 gas)
PRIVATE_KEY=0x你的私鑰
# 已部署的 PriceOracle 地址(deploy 後填入,供 feeder 使用)
ORACLE_ADDRESS=
# 一次餵價的股票數量上限(控制 gas / tx 大小)
FEED_LIMIT=120
# (選配)Etherscan 驗證用
ETHERSCAN_API_KEY=
